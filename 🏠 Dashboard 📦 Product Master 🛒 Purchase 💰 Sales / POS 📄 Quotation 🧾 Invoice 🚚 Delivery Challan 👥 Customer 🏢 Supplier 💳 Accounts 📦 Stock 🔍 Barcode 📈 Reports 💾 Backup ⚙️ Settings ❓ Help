<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SAAD Engineering ERP - Dashboard</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f4f6f9;
}

.header{
background:#004d7a;
color:#fff;
padding:20px;
text-align:center;
font-size:28px;
font-weight:bold;
}

.container{
padding:20px;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
}

.card{
background:#fff;
padding:20px;
border-radius:10px;
box-shadow:0 2px 8px rgba(0,0,0,.15);
text-align:center;
}

.card h2{
font-size:18px;
color:#333;
margin-bottom:10px;
}

.card p{
font-size:28px;
font-weight:bold;
color:#004d7a;
}

.footer{
margin-top:30px;
text-align:center;
padding:15px;
color:#666;
}
</style>

</head>

<body>

<div class="header">
SAAD ENGINEERING ERP
</div>

<div class="container">

<div class="cards">

<div class="card">
<h2>Today's Sales</h2>
<p>৳0</p>
</div>

<div class="card">
<h2>Total Purchase</h2>
<p>৳0</p>
</div>

<div class="card">
<h2>Total Stock</h2>
<p>0 Items</p>
</div>

<div class="card">
<h2>Customers</h2>
<p>0</p>
</div>

<div class="card">
<h2>Suppliers</h2>
<p>0</p>
</div>

<div class="card">
<h2>Profit</h2>
<p>৳0</p>
</div>

</div>

</div>

<div class="footer">
© 2026 SAAD Engineering ERP
</div>

</body>
</html>
