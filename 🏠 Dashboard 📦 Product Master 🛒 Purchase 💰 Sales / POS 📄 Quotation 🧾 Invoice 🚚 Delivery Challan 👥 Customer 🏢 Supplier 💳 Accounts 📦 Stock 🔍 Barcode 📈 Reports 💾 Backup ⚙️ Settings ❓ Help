<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SAAD Engineering ERP</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
display:flex;
background:#f4f6f9;
}

.sidebar{
width:250px;
height:100vh;
background:#0d47a1;
color:white;
padding:20px;
position:fixed;
}

.sidebar h2{
text-align:center;
margin-bottom:30px;
}

.sidebar ul{
list-style:none;
}

.sidebar ul li{
padding:15px;
margin:8px 0;
background:#1565c0;
border-radius:8px;
cursor:pointer;
}

.sidebar ul li:hover{
background:#1976d2;
}

.main{
margin-left:250px;
width:100%;
padding:30px;
}

.header{
background:white;
padding:20px;
border-radius:10px;
box-shadow:0 2px 10px rgba(0,0,0,.1);
margin-bottom:20px;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
}

.card{
background:white;
padding:25px;
border-radius:10px;
box-shadow:0 2px 10px rgba(0,0,0,.1);
text-align:center;
}

.card h3{
margin-bottom:10px;
}

.card p{
font-size:28px;
font-weight:bold;
color:#0d47a1;
}
</style>

</head>

<body>

<div class="sidebar">

<h2>SAAD ERP</h2>

<ul>

<li>🏠 Dashboard</li>
<li>📦 Product Master</li>
<li>🛒 Purchase</li>
<li>💰 Sales / POS</li>
<li>📄 Quotation</li>
<li>🧾 Invoice</li>
<li>🚚 Delivery Challan</li>
<li>👥 Customer</li>
<li>🏢 Supplier</li>
<li>💳 Accounts</li>
<li>📦 Stock</li>
<li>📈 Reports</li>
<li>⚙️ Settings</li>

</ul>

</div>

<div class="main">

<div class="header">

<h1>Welcome to SAAD Engineering ERP</h1>

<p>Professional Engineering Management System</p>

</div>

<div class="cards">

<div class="card">
<h3>Total Products</h3>
<p>250</p>
</div>

<div class="card">
<h3>Total Customers</h3>
<p>120</p>
</div>

<div class="card">
<h3>Today's Sales</h3>
<p>৳35,000</p>
</div>

<div class="card">
<h3>Stock Value</h3>
<p>৳12,50,000</p>
</div>

</div>

</div>

</body>
</html>
